{
    "position": "top",
    "layer": "bottom",
    "spacing": 10,
    "margin-top":0,

    "modules-center": [

	"clock",
	"mpris",
	"custom/sep",
	"ext/workspaces",
	"dwl/window#layout",
	"custom/sep",
	"pulseaudio",
	"custom/sep",
	"network",
	"custom/sep",
	"battery",
	"memory",
	"cpu"
    ],

    // Modules
    "ext/workspaces": {
	"format": "({icon})",
	"ignore-hidden": true,
	"on-click": "activate",
	"sort-by-id": true
    },
    "dwl/window#layout": {
	"format": "[{layout}]"
    },
    "clock": {
	"interval": 60,
    	"format": "{:%H:%M}",
	"tooltip": false
    },
    "pulseaudio": {
    	"format": "{volume}% {icon}",
    	"format-muted": "Muted  ",
    	"format-icons": {
            "default": [" ", " "]
        },
        "scroll-step": 1,
        "on-click": "pavucontrol",
        "ignored-sinks": [
	    "Easy Effects Sink"
	]
    },
    "network": {
	"interface": "wlan0",
    	"format": "{ifname}",
    	"format-wifi": "{essid} {icon}",
	"format-icons": [
	    "󰤯 ",
	    "󰤟 ",
	    "󰤢 ",
	    "󰤥 ",
	    "󰤨 "
	],
    	"format-ethernet": "{ipaddr}/{cidr} 󰊗 ",
    	"format-disconnected": "Offline 󰤮 ", //An empty format will hide the module.
    	"tooltip-format": "{ifname} via {gwaddr} 󰊗 ",
    	"tooltip-format-wifi": "{essid} ({signalStrength}%)",
    	"tooltip-format-ethernet": "{ifname}  ",
    	"tooltip-format-disconnected": "Disconnected",
    	"on-click": "foot --app-id nmwui nmtui",
	"max-length": 50
    },
    "battery": {
	"interval": 60,
    	"format": "{capacity}% {icon}",
    	"format-icons": {
		"default": [" ", " ", " ", " ", " "],
		"charging": [" "]

	}
    },
    "memory":{
	"format": "{percentage}%  "
    },
    "cpu":{
	"format": "{usage}%  ",
	"tooltip": false
    },
"mpris": {
	"format": "| {player_icon}  {status_icon} {title} - {artist}",
	"format-paused": "| {player_icon}  {status_icon} <i>{title} - {artist}</i>",
	"max-length": 45,
	"player-icons": {
		"default": "▶",
		"mpv": "🎵",
		"spotify": ""
	},
	"status-icons": {
		"playing": "▶",
		"paused": "⏸"
	},
	"ignored-players": ["firefox"]
    },
    "custom/sep":{
	"format": "|",
	"interval": 0
    }
}
